# 强制以 LF 存入仓库。
#
# Windows 上开发时 git 默认会把文本文件转成 CRLF，但带 CRLF 的 shell
# 脚本在 Linux 上会以 "bad interpreter: /usr/bin/env bash^M" 失败，
# Go 源码与 YAML 也应统一换行符以免 diff 噪声。
* text=auto eol=lf

# 这些必须是 LF，否则在 CI 上无法执行。
*.sh    text eol=lf
*.go    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Windows 批处理必须是 CRLF。
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做任何转换。
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.qm    binary
*.ttf   binary
*.otf   binary
